# For deploying with the C++ buildpack (not needed for the Dockerfile / container stack).
CPP_BUILD_SYSTEM=cmake
CPP_COMPILER=gcc
CPP_DEPS=auto
CPP_CMAKE_ARGS=-DWITH_NTGCALLS=ON
CPP_CMAKE_TARGETS=cpp-bot
CPP_EXECUTABLE=cpp-bot
CPP_LAUNCH_MODE=supervise

# libntgcalls: third_party/ntgcalls/ is in your .gitignore, so it cannot simply be committed.
# Use a pinned download instead (the SHA-256 is mandatory):
NTGCALLS_URL=https://github.com/pytgcalls/ntgcalls/releases/download/v2.1.0/ntgcalls.linux-x86_64-shared_libs.zip
# NTGCALLS_SHA256=<paste the output of: sha256sum ntgcalls.linux-x86_64-shared_libs.zip>
