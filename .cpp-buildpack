# Config for Badmunda05/heroku-buildpack-cpp.
# See MUSIC_BOT_DEPLOYMENT.md in that buildpack's repo for the full
# reference — this mirrors its example, adjusted to this project's
# actual CMakeLists.txt (Threads, CURL, ZLIB, mongoc, nlohmann-json).

# System/vendored libraries this project links against.
CPP_DEPS=curl,zlib,mongoc,nlohmann-json

# bin/pre_compile needs unzip to extract the ntgcalls release archive.
CPP_APT_PACKAGES=unzip

# bin/pre_compile fetches libntgcalls.so + ntgcalls.h into
# third_party/ntgcalls/{lib,include} (CMakeLists.txt's own default
# NTGCALLS_DIR) — so WITH_NTGCALLS=ON here is all that's needed, no
# -DNTGCALLS_DIR= override.
CPP_CMAKE_ARGS=-DWITH_NTGCALLS=ON

# Must match the name bin/post_compile copies libntgcalls.so into.
CPP_BUILD_DIR_NAME=build
